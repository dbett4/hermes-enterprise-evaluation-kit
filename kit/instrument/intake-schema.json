{
  "$id": "hermes://b03/intake/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "intended_outcome": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "named_operating_owner": {
          "type": "string"
        },
        "named_policy_owner": {
          "type": "string"
        },
        "resume_trigger": {
          "type": "string"
        },
        "sources_targets_exceptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workflow_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "handoff": {
          "additionalProperties": false,
          "properties": {
            "atr_required": {
              "enum": [
                "yes",
                "no",
                "not_applicable",
                "unknown"
              ],
              "type": "string"
            },
            "cross_principal_required": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            "import_disposition_class": {
              "enum": [
                "deterministic-oracle",
                "human-disposition",
                "role-separated",
                "unknown"
              ],
              "type": "string"
            },
            "minimum_grant_scope": {
              "enum": [
                "execute-within-envelope",
                "read",
                "recommend",
                "unknown"
              ],
              "type": "string"
            },
            "source_principal_class": {
              "type": "string"
            },
            "target_principal_class": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "mission",
        "intended_outcome",
        "baseline",
        "workflow_actions",
        "sources_targets_exceptions",
        "named_operating_owner",
        "named_policy_owner",
        "acceptance_criteria",
        "resume_trigger"
      ],
      "type": "object"
    },
    "classification_groups": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "advise",
                "destructive",
                "draft",
                "external_effect",
                "internal_coordinate",
                "payment",
                "privilege_change",
                "production_change",
                "publication",
                "read",
                "unknown",
                "write"
              ],
              "type": "string"
            },
            "environment": {
              "enum": [
                "customer",
                "external",
                "internal_nonproduction",
                "production",
                "sandbox",
                "unknown"
              ],
              "type": "string"
            },
            "external_effect": {
              "enum": [
                "critical",
                "material",
                "none",
                "reversible",
                "unknown"
              ],
              "type": "string"
            },
            "privilege": {
              "enum": [
                "critical",
                "limited",
                "meaningful",
                "none",
                "unknown"
              ],
              "type": "string"
            },
            "target": {
              "enum": [
                "bounded_set",
                "broad_population",
                "explicit_single",
                "none",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "action",
            "target",
            "environment",
            "external_effect",
            "privilege"
          ],
          "type": "object"
        },
        "consequence": {
          "additionalProperties": false,
          "properties": {
            "consequence": {
              "enum": [
                "critical",
                "low",
                "material",
                "negligible",
                "noncritical",
                "severe",
                "unknown"
              ],
              "type": "string"
            },
            "population": {
              "enum": [
                "bounded",
                "broad",
                "single",
                "unknown"
              ],
              "type": "string"
            },
            "recallability": {
              "enum": [
                "bounded",
                "difficult",
                "immediate",
                "impossible",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "consequence",
            "population",
            "recallability"
          ],
          "type": "object"
