              "type": "string"
            },
            "readback": {
              "enum": [
                "available",
                "named",
                "not_applicable",
                "tested",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            },
            "recovery": {
              "enum": [
                "bounded",
                "immediate",
                "long",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            },
            "reversibility": {
              "enum": [
                "bounded_reversible",
                "difficult",
                "fully_reversible",
                "irreversible",
                "unknown"
              ],
              "type": "string"
            },
            "rollback": {
              "enum": [
                "available",
                "named",
                "not_applicable",
                "tested",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            },
            "safe_state": {
              "enum": [
                "available",
                "named",
                "not_applicable",
                "tested",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            }
