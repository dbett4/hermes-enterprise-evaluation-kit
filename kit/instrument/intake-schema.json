          "required": [
            "reversibility",
            "rollback",
            "readback",
            "safe_state",
            "idempotency",
            "recovery"
          ],
          "type": "object"
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "custody": {
              "enum": [
                "actor_independent",
                "mutable_local",
                "retained",
                "separate_controlled",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            },
            "evidence_completeness": {
              "enum": [
                "complete",
                "contradictory",
                "partial",
                "unknown"
              ],
              "type": "string"
            },
            "verifier_strength": {
              "enum": [
                "deterministic",
                "human",
                "model_independent",
                "organizationally_independent",
                "role_separated",
                "self_report",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "verifier_strength",
            "custody",
            "evidence_completeness"
          ],
          "type": "object"
