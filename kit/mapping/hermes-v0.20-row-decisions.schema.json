{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes://b05/row-decisions-schema/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "baseline_commit",
    "denominator_path",
    "denominator_sha256",
    "requirement_count",
    "digest_encoding",
    "decisions"
  ],
  "properties": {
    "$schema": {
      "const": "hermes://b05/row-decisions-schema/v3"
    },
    "schema_version": {
      "const": "2A"
    },
    "manifest_id": {
      "const": "hermes-v0.20-row-decisions"
    },
    "baseline_commit": {
      "const": "dd71c1cb51b1bfc85484a44d939c6f66f88d3eb8"
    },
    "denominator_path": {
      "const": "kit/mapping/neutral-requirements.json"
    },
    "denominator_sha256": {
      "const": "3b28dac2ef24d463917e4e11bdd4e200aff42568d93e5cc28b4f2496209f143f"
    },
    "requirement_count": {
      "const": 318
    },
    "digest_encoding": {
      "const": "json-object-sorted-compact-utf8-v1"
    },
    "decisions": {
      "type": "array",
      "minItems": 318,
      "maxItems": 318,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "requirement_key",
              "requirement_digest",
              "adjudication_state"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "pattern": "^B05-DEC-(?:00(?:0[1-9]|[1-9][0-9])|0[1-2][0-9]{2}|03(?:0[0-9]|1[0-8]))$"
              },
              "requirement_key": {
                "type": "string",
                "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
              },
              "requirement_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "adjudication_state": {
                "const": "pending"
              }
            }
          },
          {
            "$ref": "hermes://b05/adjudicated-decision-schema/v2"
          }
        ]
      }
    },
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_identity",
        "evidence_basis"
      ],
      "properties": {
        "topology_identity": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        },
        "evidence_basis": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decisions": {
            "contains": {
              "properties": {
                "adjudication_state": {
                  "const": "pending"
                }
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "release_context"
          ]
        }
      },
      "else": {
        "required": [
          "release_context"
        ]
      }
    }
  ]
}
