              "type": "string"
            },
            "boundary_dependencies": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "boundary_unavailable_behavior": {
              "enum": [
                "fail_closed_retryable",
                "fail_closed_terminal",
                "fail_open_forbidden",
                "unknown"
              ],
              "type": "string"
            },
            "enforcement_location": {
              "type": "string"
            },
            "identity_source": {
              "enum": [
                "authenticated_gateway_event",
                "configured_local_operator",
                "delegated_parent_session",
                "unknown"
              ],
              "type": "string"
            },
            "mount_semantics": {
              "enum": [
                "deny_by_default",
                "explicit_grant_only",
                "read_only_default",
                "unknown"
              ],
              "type": "string"
            },
            "recheck_cadence": {
              "enum": [
                "per_session",
                "per_tool_call",
                "per_turn",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "data_source",
        "action",
        "consequence",
        "reversibility",
        "novelty",
        "identity",
        "verification",
        "operations"
      ],
      "type": "object"
    },
    "instrument_config": {
      "additionalProperties": false,
      "properties": {
        "h2_available": {
          "const": false
        }
      },
      "required": [
        "h2_available"
      ],
      "type": "object"
    },
    "instrument_id": {
      "const": "b03-scoping-instrument-v2"
    },
    "occurrence": {
      "additionalProperties": false,
      "properties": {
        "accepted_first_h_record_ref": {
          "minLength": 1,
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "human_release_mechanism_available": {
          "enum": [
            "unknown",
            "available",
            "unavailable"
          ],
          "type": "string"
        },
        "observed_effect_ref": {
          "minLength": 1,
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "policy_ratification_ref": {
          "minLength": 1,
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "state": {
          "enum": [
            "unknown",
            "first",
            "subsequent"
          ],
          "type": "string"
        },
        "tested_recovery_ref": {
          "minLength": 1,
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "tuple_identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tuple_identity",
        "state",
        "accepted_first_h_record_ref",
        "observed_effect_ref",
        "tested_recovery_ref",
        "policy_ratification_ref",
        "human_release_mechanism_available"
      ],
      "type": "object"
    }
