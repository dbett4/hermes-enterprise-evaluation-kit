        "data_source": {
          "additionalProperties": false,
          "properties": {
            "data": {
              "enum": [
                "confidential",
                "impermissible",
                "internal",
                "public",
                "regulated",
                "restricted",
                "unknown"
              ],
              "type": "string"
            },
            "purpose": {
              "enum": [
                "allowed",
                "prohibited",
                "unknown"
              ],
              "type": "string"
            },
            "residency": {
              "enum": [
                "constrained",
                "prohibited",
                "unknown",
                "unrestricted"
              ],
              "type": "string"
            },
            "retention": {
              "enum": [
                "bounded",
                "none",
                "prohibited",
                "required",
                "unknown"
              ],
              "type": "string"
            },
            "source_authority": {
              "enum": [
                "authoritative",
                "conflicting",
                "declared",
                "unknown",
                "untrusted"
              ],
              "type": "string"
            }
          },
          "required": [
            "data",
            "source_authority",
            "purpose",
            "residency",
            "retention"
          ],
          "type": "object"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "credential_reach": {
              "enum": [
                "critical",
                "limited_write",
                "none",
                "privileged",
                "read_only",
                "unknown"
              ],
              "type": "string"
            },
            "delegation": {
              "enum": [
                "broad",
                "critical",
                "explicit_narrow",
                "none",
                "unknown"
              ],
              "type": "string"
            },
            "identity": {
              "enum": [
                "authenticated",
                "named",
                "service",
                "shared",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            },
            "segregation": {
              "enum": [
                "dual_control_required",
                "human_release",
                "not_required",
                "unavailable",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "identity",
            "delegation",
            "credential_reach",
            "segregation"
          ],
          "type": "object"
        },
        "novelty": {
          "additionalProperties": false,
          "properties": {
            "ambiguity": {
              "enum": [
                "ambiguous",
                "bounded",
                "fixed_schema",
                "unknown"
              ],
              "type": "string"
            },
            "exception_frequency": {
              "enum": [
                "high",
                "none",
                "rare",
                "recurring",
                "unknown"
              ],
              "type": "string"
            },
            "model_judgment": {
              "enum": [
                "acceptance_critical",
                "none",
                "present",
                "unknown"
              ],
              "type": "string"
            },
            "novelty": {
              "enum": [
                "bounded",
                "fixed",
                "novel",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "novelty",
            "ambiguity",
            "model_judgment",
            "exception_frequency"
          ],
          "type": "object"
        },
        "operations": {
          "additionalProperties": false,
          "properties": {
            "adoption_burden": {
              "enum": [
                "material",
                "multi_owner",
                "single_owner",
                "staff_displacement",
                "unknown"
              ],
              "type": "string"
            },
            "cost_value": {
              "enum": [
                "control_cost_exceeds_value",
                "plausible",
                "public_claim_requires_evidence",
                "unknown"
              ],
              "type": "string"
            },
            "dependencies": {
              "enum": [
                "fixed",
                "outcome_changing",
                "unknown"
              ],
              "type": "string"
            },
            "duration": {
              "enum": [
                "bounded",
                "long_lived",
                "one_shot",
                "unknown"
              ],
              "type": "string"
            },
            "supplier_change": {
              "enum": [
                "none",
                "nonmaterial",
                "outcome_changing",
                "unknown"
              ],
              "type": "string"
            }
