        "applicability": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        },
        "native_first": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "considered_surface_ids",
            "strongest_builtin_primitive",
            "sufficient"
          ],
          "properties": {
            "considered_surface_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "HS-PROFILE-DISTRIBUTION",
                  "HS-GOALS",
                  "HS-APPROVAL-DENY",
                  "HS-SMART-APPROVAL",
                  "HS-WEBHOOKS",
                  "HS-IRON-PROXY",
                  "HS-OS-CONTAINER-ISOLATION",
                  "HS-MANAGED-SCOPE",
                  "HS-KANBAN",
                  "HS-PROVIDER-ROUTING",
                  "HS-FALLBACK",
                  "HS-MODEL-EFFORT-CONFIG",
                  "HS-GATEWAY-EXACT-TAG",
                  "HS-GATEWAY-INSTALLED",
                  "HS-GATEWAY-E2E",
                  "HS-EVIDENCE-PACKET",
                  "HS-PORTAL-METERING",
                  "HS-NON-REFERENCE-SURFACES"
                ]
              }
            },
            "strongest_builtin_primitive": {
              "type": "string",
              "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
            },
            "sufficient": {
              "type": "boolean"
            },
            "insufficiency_reason": {
              "type": "string",
              "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "sufficient": {
                    "const": false
                  }
                }
              },
              "then": {
                "required": [
                  "insufficiency_reason"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "sufficient": {
                    "const": true
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "insufficiency_reason"
                  ]
                }
              }
            }
          ]
        }
      }
    },
