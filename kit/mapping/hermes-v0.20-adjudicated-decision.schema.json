          "HS-EVIDENCE-PACKET",
          "HS-PORTAL-METERING",
          "HS-NON-REFERENCE-SURFACES"
        ]
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "configuration",
        "owner",
        "applicability",
        "native_first"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        },
        "configuration": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
