{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes://b05/adjudicated-decision-schema/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "requirement_key",
    "requirement_digest",
    "adjudication_state",
    "atomic_obligations",
    "family",
    "status",
    "eligible_surface_ids",
    "implementation",
    "evidence",
    "boundary",
    "reference_use",
    "incomplete_treatment",
    "staleness",
    "requirement_trace"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^B05-DEC-(?:00(?:0[1-9]|[1-9][0-9])|0[1-2][0-9]{2}|03(?:0[0-9]|1[0-8]))$"
    },
    "requirement_key": {
      "type": "string",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
    },
    "requirement_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication_state": {
      "const": "adjudicated"
    },
    "atomic_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
      }
    },
    "family": {
      "type": "string",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_status",
        "supporting_statuses",
        "rationale"
      ],
      "properties": {
        "primary_status": {
          "type": "string",
          "enum": [
            "native",
            "configuration",
            "extension",
            "surrounding-platform",
            "unsupported-gap"
          ]
        },
        "supporting_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "native",
              "configuration",
              "extension",
              "surrounding-platform",
              "unsupported-gap"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        }
      }
    },
    "eligible_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "HS-PROFILE-DISTRIBUTION",
          "HS-GOALS",
          "HS-APPROVAL-DENY",
          "HS-SMART-APPROVAL",
          "HS-WEBHOOKS",
          "HS-IRON-PROXY",
          "HS-OS-CONTAINER-ISOLATION",
          "HS-MANAGED-SCOPE",
          "HS-KANBAN",
          "HS-PROVIDER-ROUTING",
          "HS-FALLBACK",
          "HS-MODEL-EFFORT-CONFIG",
          "HS-GATEWAY-EXACT-TAG",
