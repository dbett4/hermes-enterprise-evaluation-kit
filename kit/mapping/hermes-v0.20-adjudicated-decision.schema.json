        },
        "basis": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        },
        "bounded_claim": {
          "type": "string",
          "pattern": "^(?!\\s)(?!.*\\s$)(?!\\s*(?i:(?:default|unknown|none|n-a|n/a|tbd(?:\\s+(?:later|pending))?)|[-?.*]+)\\s*$).+$"
        }
